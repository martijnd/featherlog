{
  "name": "server",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "build:admin": "pnpm --filter admin build",
    "build:all": "pnpm build:admin && pnpm build",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "create-user": "tsx src/scripts/create-user.ts",
    "create-project": "tsx src/scripts/create-project.ts",
    "migrate-from-postgres": "tsx src/scripts/migrate-from-postgres.ts"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.24.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
