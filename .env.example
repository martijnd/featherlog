# Server Environment Variables
JWT_SECRET=your-secret-key-change-in-production

# Admin UI (packages/admin) — usually leave VITE_API_URL unset so /api is same-origin (Vite proxy or nginx).
# VITE_API_URL=

# Database (if not using docker-compose)
# POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/featherlog
