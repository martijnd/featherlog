# Server Environment Variables
JWT_SECRET=your-secret-key-change-in-production

# Admin UI (packages/admin) — usually leave VITE_API_URL unset so /api is same-origin (Vite proxy or nginx).
# VITE_API_URL=

# Database (if not using docker-compose)
# MYSQL_URL=mysql://featherlog:featherlog@localhost:3306/featherlog
